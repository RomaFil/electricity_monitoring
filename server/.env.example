# Скопіюй у .env і заповни. .env ніколи не потрапляє в git.

# Де слухає дашборд: лише WireGuard-адреса VPS
BIND_ADDR=10.0.0.1
HOST_PORT=3003
TZ=Europe/Kyiv

# Джерело "село": healthchecks | direct | off
VILLAGE_SOURCE=healthchecks
# Скільки секунд без пінгу = "немає сигналу" (3 пропущені пінги по 60 с)
VILLAGE_THRESHOLD_S=180
POLL_INTERVAL_S=60

# Healthchecks: ПОВНИЙ API-ключ окремого проєкту (read-only не віддає тіла пінгів)
HC_API_BASE=https://healthchecks.io
HC_API_KEY=
# UUID перевірки — та сама частина, що в https://hc-ping.com/<UUID>
HC_CHECK_UUID=

# Токени пристроїв зберігаються лише як sha256-хеш.
# Згенерувати: python3 -c "import secrets,hashlib;t=secrets.token_urlsafe(32);print(t);print(hashlib.sha256(t.encode()).hexdigest())"
# Перший рядок (сам токен) -> у /etc/power-guard.conf на ноутбуці, другий (хеш) -> сюди.
POWER_KEY_SHA256=
# Лише для режиму direct
HEARTBEAT_KEY_SHA256=

# Через скільки секунд без звіту від power-guard показувати "немає даних"
HOME_STALE_S=120
# Має збігатися з WAKE_INTERVAL у /etc/power-guard.conf
HOME_WAKE_INTERVAL_S=300

# Офіційні графіки ДТЕК для звірки (регіон:група з github.com/Baskerville42/outage-data-ua); порожньо = без звірки
SCHEDULE_HOME=kyiv:GPV1.1
SCHEDULE_VILLAGE=kyiv-region:GPV4.2

# Температура надворі для графіка села (Open-Meteo, без ключа); порожній OUTDOOR_LAT = вимкнено
OUTDOOR_LAT=50.6331
OUTDOOR_LON=30.0239

# Підписані команди платі з дашборда: перезапуск, перечитати датчик, оновити прошивку з GitHub.
# Той самий рядок вписати на сторінці налаштувань плати («Ключ команд»). Порожньо = кнопки вимкнені.
# Згенерувати: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
ESP_CMD_KEY=
# Звідки плата бере firmware.bin.signed (GitHub Releases)
FW_REPO=RomaFil/electricity_monitoring
